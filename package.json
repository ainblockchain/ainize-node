{
  "name": "@ainize/node",
  "version": "0.2.2",
  "description": "Ainize node \u2014 serves a base model whose conditional memory is extended by knowledge patches; teaches, verifies, publishes and trades patches on the AIN ledger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainblockchain/ainize-node.git"
  },
  "homepage": "https://github.com/ainblockchain/ainize",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "trainer"
  ],
  "bin": {
    "ainize-node": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/bin.ts",
    "start": "node dist/bin.js",
    "seed": "tsx src/seed.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@ainize/core": "^0.2.0",
    "aindrive": "^0.2.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "yjs": "^13.6.30",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}