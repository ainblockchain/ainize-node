[Unit]
Description=Check main for ainize web and node every few minutes

[Timer]
# 부팅 직후 한 번, 그다음 5분마다. `Persistent` 는 쓰지 않는다 — 기계가 꺼져 있던 동안의
# 배포를 몰아서 돌릴 이유가 없다. 다음 주기에 어차피 같은 것을 본다.
#
# 2분이었다. 머지에서 배포까지의 지연은 사람이 느끼기에 차이가 없고(빌드가 그보다 오래 걸린다),
# GitHub 로 나가는 호출은 60% 줄어든다. 실패했을 때의 간격은 여기서 정하지 않는다 —
# deploy/backoff.sh 가 실패마다 배로 늘려 최대 1시간까지 미룬다.
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
